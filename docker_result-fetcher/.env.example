# Copy this file to ".env" in this "docker_result-fetcher/" directory
# (same directory as docker-compose.yml) and fill in your real values.
# It's a *separate* file from the "../.env" used by water_form_filler.py
# on your own machine -- different data, different secrets, and Docker
# Compose only ever reads env_file relative to this folder.
# ".env" here is gitignored and never committed.

# --- Trigger mailbox (IMAP) -------------------------------------------
# A dedicated email account/address, separate from whatever sends the
# result-ready emails below. water_form_filler.py (on your own machine)
# emails this address after each submission; this script reads it via
# IMAP (an outbound connection this script initiates -- no inbound port
# needed on this side, unlike the webhook this replaced).
#
# Most providers require an app-specific password for IMAP login rather
# than your normal account password (Gmail, iCloud, etc. all do).
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
# Leave at the default unless you have a reason to file trigger emails
# somewhere other than the inbox.
IMAP_MAILBOX=INBOX

# Your last name, exactly as used on the requisition form -- needed to
# query the Get Results tab. Trigger emails deliberately do NOT carry
# this (only a barcode + timestamp travel through the trigger mailbox,
# on purpose -- your last name doesn't change between samples, so
# there's no reason to email it every time). Required whenever
# IMAP_HOST above is set.
RESULT_LAST_NAME=

# Shared secret that decrypts the trigger email body. Must exactly
# match TRIGGER_ENCRYPTION_KEY in the root .env on your Mac -- copy the
# same value into both files, generated with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required whenever IMAP_HOST above is set.
TRIGGER_ENCRYPTION_KEY=

# Where the pending-samples list and downloaded PDFs live inside the
# container. Leave as-is -- these paths are what docker-compose.yml
# mounts as a volume so they survive container restarts.
PENDING_SAMPLES_FILE=/data/pending_samples.json
DOWNLOAD_DIR=/data/downloads

# How long (ms) to wait for a PDF download after clicking Submit on the
# "Get Results" form before concluding "not ready yet".
RESULT_DOWNLOAD_TIMEOUT_MS=15000

# Send a warning email listing samples still unresolved after this many
# days (PHO's own estimate is 2-4 business days).
RESULT_OVERDUE_DAYS=10

# SMTP settings for sending result emails, used directly via Python's
# smtplib -- no other mail mechanism is involved. If you're running
# this on a Synology and have already set up DSM's own email
# notifications (Control Panel -> Notification -> Email), you can just
# reuse those same server/account/password values here rather than
# creating new SMTP credentials from scratch -- DSM's notification
# feature itself isn't used, only the credentials are borrowed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left empty.
SMTP_FROM=
# Where result/overdue-warning emails get sent.
RESULT_EMAIL_TO=
