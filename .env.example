# Copy this file to ".env" and fill in your real, constant information.
# ".env" is gitignored -- it never gets committed. Everything that
# changes per sample (barcode, collection date/time) is asked for
# interactively by water_form_filler.py and does NOT live here.
#
# Leave a value empty if it's optional and doesn't apply to you.
# Required (*) fields on the form are marked below.
#
# Values marked "(dropdown option text)" must match the on-page
# dropdown's visible text EXACTLY, including case (e.g. "Street" not
# "street") -- the dropdowns on this form do an exact-text lookup.
#
# NOTE: don't put comments on the same line as a value -- some .env
# parsers treat everything after "=" (including "#...") as part of the
# value. Keep comments on their own line, like below.

# --- Mailing address contact info -------------------------------------
# * required
LAST_NAME=
# optional
FIRST_NAME=
# optional, e.g. 4165551234
PHONE_NUMBER=

# --- Purification system -----------------------------------------------
# The form asks "Purification system used (e.g., UV, filtration, etc.)"
# as a plain Yes/No choice -- no free-text field.
# true -> clicks "Yes", false -> clicks "No"
PURIFICATION_SYSTEM_USED=false

# --- Mailing address ----------------------------------------------------
# The form has an address-lookup field plus a "My address is not listed"
# link that reveals plain manual fields (Unit/Street No/Street Name/...).
# This script always uses the manual fields since they're far more
# reliable to automate than an address-autocomplete widget.
MAILING_UNIT_NO=
# * required
MAILING_STREET_NO=
# * required
MAILING_STREET_NAME=
# e.g. Street, Road, Avenue (dropdown option text)
MAILING_STREET_TYPE=
# e.g. North (dropdown option text)
MAILING_STREET_DIRECTION=
MAILING_RURAL_ROUTE=
MAILING_PO_BOX=
# * required
MAILING_CITY_TOWN=
MAILING_POSTAL_CODE=
# * required
MAILING_PROVINCE_STATE=
MAILING_COUNTRY=

# --- Water source address ------------------------------------------------
# If the water source is at the same address as above, leave this true
# and the water-source-address section is skipped entirely (the form's
# own checkbox handles it).
WATER_SOURCE_SAME_AS_MAILING=true

# Only used if WATER_SOURCE_SAME_AS_MAILING is false:
WATER_UNIT_NO=
WATER_STREET_NO=
WATER_STREET_NAME=
WATER_STREET_TYPE=
WATER_STREET_DIRECTION=
WATER_LOT_NO=
WATER_CONCESSION=
WATER_EMERGENCY_LOCATOR=
# * required (dropdown option text)
WATER_TOWNSHIP_MUNICIPALITY=
# (dropdown option text)
WATER_COUNTY_DISTRICT=
WATER_POSTAL_CODE=

# --- Public Health Unit --------------------------------------------------
# * required (dropdown option text), e.g. "Durham Regional",
# "City of Toronto", "Middlesex-London", etc.
PUBLIC_HEALTH_UNIT=
